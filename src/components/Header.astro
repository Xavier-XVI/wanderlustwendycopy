---
// Header.astro — Site header with wordmark and tagline
// Centered layout, clean white background, subtle bottom border
---

<header class="w-full bg-white border-b border-gray-100 py-8 px-4">
  <div class="max-w-5xl mx-auto text-center">
    <a
      href="/"
      class="block no-underline hover:opacity-100 group"
      aria-label="Wanderlust Wendy — Home"
    >
      <h1 class="font-serif text-[2.25rem] md:text-[2.75rem] font-bold leading-tight tracking-tight text-[#1f1d1d] group-hover:opacity-80 transition-opacity duration-200">
        Wanderlust Wendy
      </h1>
    </a>
    <p class="font-sans text-[15px] text-[#2e2b2b] mt-2 tracking-wide uppercase">
      Twin mom.&ensp;World traveller.&ensp;Honest stories.
    </p>
  </div>
</header>
