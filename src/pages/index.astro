---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

// Placeholder recent posts — will be replaced with real content collection queries in Phase 1D
const recentPosts = [
  {
    title: "Hello, Again — Why I'm Rebuilding This Blog from Scratch",
    date: "2024-11-01",
    category: "Reflection",
    excerpt: "I walked away from this blog for two years. Here's what changed, what didn't, and why I decided to start over instead of just picking up where I left off.",
    slug: "hello-again",
    heroImage: undefined,
    featured: true,
  },
  {
    title: "Hiking the Rice Terraces of Sapa, Vietnam (With a Three-Year-Old in Tow)",
    date: "2024-09-15",
    category: "Travelogue",
    excerpt: "Nobody warned me how steep the trails actually are. Our guide, Mai, was patient in a way I aspire to be. The kids mostly complained about the mud and loved every second of it.",
    slug: "sapa-vietnam-hiking",
    heroImage: undefined,
    featured: false,
  },
  {
    title: "The Ha Giang Loop by Car: What the Motorbike Crowd Doesn't Tell You",
    date: "2024-08-03",
    category: "Travelogue",
    excerpt: "Yes, you can do Ha Giang without a motorbike. And yes, you will still have your breath taken away at every switchback. What changes is the pace — and the conversations you have along the way.",
    slug: "ha-giang-car-tour",
    heroImage: undefined,
    featured: false,
  },
];
---

<BaseLayout
  title="Wanderlust Wendy"
  description="Honest travel stories and life abroad from a twin mom, world traveller, and recovering over-planner."
  currentPath="/"
>

  <!-- Hero section -->
  <section class="text-center max-w-3xl mx-auto mb-20">
    <h1 class="font-serif font-bold text-[#1f1d1d] text-[2.25rem] md:text-[3.625rem] leading-[1.15] mb-6">
      Stories from the road —<br class="hidden md:inline" />
      and life in between.
    </h1>
    <p class="font-sans text-[18px] text-[#3a3636] leading-[1.6] max-w-xl mx-auto mb-8">
      I'm Wendy — twin mom, former expat, recovering over-planner. I travel slowly,
      write honestly, and never accept free hotels. This is where I share what I
      actually experienced, not just the highlight reel.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="/destinations"
        class="inline-block font-sans text-[15px] font-semibold text-white bg-[#b72e09] px-6 py-3 rounded-sm no-underline hover:opacity-85 transition-opacity duration-150"
      >
        Browse Destinations
      </a>
      <a
        href="/living-abroad"
        class="inline-block font-sans text-[15px] font-semibold text-[#b72e09] border border-[#b72e09] px-6 py-3 rounded-sm no-underline hover:bg-[#f5f0eb] transition-colors duration-150"
      >
        Life Abroad
      </a>
    </div>
  </section>

  <!-- Divider -->
  <div class="border-t border-gray-100 mb-16"></div>

  <!-- Recent Posts section -->
  <section>
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="font-serif font-bold text-[#1f1d1d] text-[1.75rem] md:text-[2.25rem] m-0">
        Recent Posts
      </h2>
      <a
        href="/destinations"
        class="font-sans text-[14px] text-[#b72e09] no-underline hover:opacity-75 transition-opacity duration-150"
      >
        All posts &rarr;
      </a>
    </div>

    <!-- Posts grid: featured card spans 2 cols on md+ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {recentPosts.map((post) => (
        <PostCard
          title={post.title}
          date={post.date}
          category={post.category}
          excerpt={post.excerpt}
          slug={post.slug}
          featured={post.featured}
        />
      ))}
    </div>
  </section>

  <!-- About strip -->
  <section class="mt-20 bg-[#f5f0eb] rounded-sm px-8 py-10 max-w-3xl mx-auto text-center">
    <h2 class="font-serif font-bold text-[#1f1d1d] text-[1.5rem] mb-3 mt-0">
      About this blog
    </h2>
    <p class="font-sans text-[17px] text-[#3a3636] leading-[1.6] mb-5 max-w-lg mx-auto">
      No affiliate links. No sponsored posts. No stock photos. Just field notes
      from someone who moves through the world one slow trip at a time.
    </p>
    <a
      href="/contact"
      class="font-sans text-[14px] font-semibold text-[#b72e09] no-underline border-b border-[#b72e09] pb-0.5 hover:opacity-75 transition-opacity duration-150"
    >
      Say hello &rarr;
    </a>
  </section>

</BaseLayout>
