---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Wendy — for reader questions, collaboration inquiries, or just to say hello."
  currentPath="/contact"
>

  <div class="max-w-2xl mx-auto">

    <h1 class="font-serif font-bold text-[#1f1d1d] text-[2.25rem] md:text-[3rem] leading-[1.15] mb-4 mt-0">
      Say hello.
    </h1>
    <p class="font-sans text-[18px] text-[#3a3636] leading-[1.6] mb-10">
      I'm genuinely happy to hear from readers. Whether you have a question about a destination,
      want to share your own experience, or just want to say you found something useful here —
      feel free to reach out.
    </p>

    <!-- What I respond to -->
    <div class="bg-[#f5f0eb] rounded-sm px-7 py-6 mb-10">
      <h2 class="font-serif font-bold text-[#1f1d1d] text-[1.25rem] mb-3 mt-0">
        What I respond to
      </h2>
      <ul class="font-sans text-[16px] text-[#3a3636] leading-[1.7] list-none m-0 p-0 space-y-1">
        <li>✓ &nbsp;Reader questions about posts or destinations</li>
        <li>✓ &nbsp;Travel tips or local knowledge you want to share</li>
        <li>✓ &nbsp;Feedback on the site or writing</li>
        <li>✓ &nbsp;Media or editorial inquiries (publications, podcasts)</li>
      </ul>
      <p class="font-sans text-[14px] text-[#888] mt-4 mb-0 italic">
        I don't do sponsored posts, affiliate partnerships, or hotel/product reviews in exchange for compensation. Please don't pitch those.
      </p>
    </div>

    <!-- Contact form (Formspree) -->
    <form
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
      class="space-y-6"
    >
      <div>
        <label for="name" class="block font-sans text-[14px] font-semibold text-[#2e2b2b] mb-2 uppercase tracking-wide">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="w-full font-sans text-[16px] text-[#141313] bg-white border border-gray-200 rounded-sm px-4 py-3 focus:outline-none focus:border-[#b72e09] transition-colors duration-150"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="block font-sans text-[14px] font-semibold text-[#2e2b2b] mb-2 uppercase tracking-wide">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="w-full font-sans text-[16px] text-[#141313] bg-white border border-gray-200 rounded-sm px-4 py-3 focus:outline-none focus:border-[#b72e09] transition-colors duration-150"
          placeholder="your@email.com"
        />
      </div>

      <div>
        <label for="message" class="block font-sans text-[14px] font-semibold text-[#2e2b2b] mb-2 uppercase tracking-wide">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="w-full font-sans text-[16px] text-[#141313] bg-white border border-gray-200 rounded-sm px-4 py-3 focus:outline-none focus:border-[#b72e09] transition-colors duration-150 resize-vertical"
          placeholder="What's on your mind?"
        ></textarea>
      </div>

      <button
        type="submit"
        class="font-sans text-[15px] font-semibold text-white bg-[#b72e09] px-8 py-3 rounded-sm cursor-pointer border-none hover:opacity-85 transition-opacity duration-150"
      >
        Send message
      </button>
    </form>

    <p class="font-sans text-[13px] text-[#aaa] mt-8">
      This form uses <a href="https://formspree.io" class="text-[#aaa]" target="_blank" rel="noopener noreferrer">Formspree</a> for delivery.
      Your information is not stored or shared.
    </p>

  </div>

</BaseLayout>
